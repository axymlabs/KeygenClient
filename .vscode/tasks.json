{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run (macOS)",
      "type": "shell",
      "command": "flutter run -d macos",
      "group": { "kind": "build", "isDefault": true },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "panel": "dedicated" }
    },
    {
      "label": "Run (choose device)",
      "type": "shell",
      "command": "flutter run -d ${input:device}",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "panel": "dedicated" }
    },
    {
      "label": "Analyze",
      "type": "shell",
      "command": "flutter analyze",
      "problemMatcher": []
    },
    {
      "label": "Test",
      "type": "shell",
      "command": "flutter test",
      "group": "test",
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "device",
      "type": "promptString",
      "description": "Device id (see `flutter devices`)",
      "default": "macos"
    }
  ]
}
